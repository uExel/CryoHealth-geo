{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/check-gstack.sh\""
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(./**/dist/**)",
      "Read(./**/build/**)",
      "Read(./**/.next/**)",
      "Read(./**/coverage/**)",
      "Read(./**/*.generated.*)",
      "Read(./ios/Pods/**)",
      "Read(./android/app/build/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)"
    ]
  },
  "extraKnownMarketplaces": {
    "uxl-harness": {
      "source": {
        "source": "github",
        "repo": "uExel/uxl-harness"
      }
    }
  },
  "enabledPlugins": {
    "uexel@uxl-harness": true
  }
}
