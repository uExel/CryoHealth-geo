# Copy to .env for local use with --source cdse. Never commit real values.
# Get these from a free account + OAuth2 client at dataspace.copernicus.eu
# (Sentinel Hub-scoped client — the client id is typically prefixed "sh-").
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# CryoHealth-api connection, for reporting hazard scores (pipeline/hazard_client.py).
# CRYOHEALTH_API_KEY must match CryoHealth-api's GEO_SERVICE_API_KEY exactly.
CRYOHEALTH_API_URL=http://localhost:3000
CRYOHEALTH_API_KEY=

# Postgres connection — defaults already match the shared docker-compose Postgres both
# services use locally (DB_PORT 5433); only needed here to override.
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=cryohealth
# DB_PASSWORD=cryohealth-dev
# DB_NAME=cryohealth

# AlphaEarth / Google Earth Engine (Issue #18 — pipeline/alphaearth_source.py)
# NDWI fallback is used when these are absent — no breakage without them.
# Option A: service account JSON key file (recommended for production).
# EE_SERVICE_ACCOUNT=my-service-account@my-project.iam.gserviceaccount.com
# EE_PRIVATE_KEY_JSON=/path/to/service-account-key.json
# Option B: Application Default Credentials (local dev via gcloud).
#   Run: gcloud auth application-default login
#   Then leave EE_SERVICE_ACCOUNT and EE_PRIVATE_KEY_JSON unset.
EE_FETCH_TIMEOUT_S=8

# ONNX segmentation adapter (Issue #18 — pipeline/ml_segmentation.py)
# Weights are pending Issue #19. NDWI fallback used when ML_MODEL_PATH is unset.
# ML_MODEL_PATH=/path/to/glacial_lake_adapter_v1.onnx
ML_INFERENCE_TIMEOUT_S=2.5
# ML_USE_CUDA=0
